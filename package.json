		"@vitejs/plugin-react": "^5.1.4",
		"husky": "^9.1.7",
		"jsdom": "^28.0.0",
		"lint-staged": "^16.2.7",
		"postcss": "^8.5.6",
		"tailwindcss": "^4.1.9",
		"tw-animate-css": "^1.3.7",
		"typescript": "~5.7.2",
		"vitest": "^4.0.18"
