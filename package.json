		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"embla-carousel-react": "^8.6.0",
		"framer-motion": "^12.4.10",
		"lucide-react": "^0.542.0",
		"next": "^16.0.10",
		"next-themes": "^0.4.6",
		"radix-ui": "^1.4.3",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"shadcn": "^3.8.4",
