{
	"name": "TeamUp-landing",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "next build",
		"dev": "next dev",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"start": "next start",
		"test": "vitest",
